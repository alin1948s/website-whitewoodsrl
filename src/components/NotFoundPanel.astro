---
import type { SiteLanguage } from "../lib/language";
import WoodMotif from "./WoodMotif.astro";

interface Props {
  language: SiteLanguage;
  title: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  eyebrow?: string;
}

const { language, title, description, primaryHref, primaryLabel, secondaryHref, secondaryLabel, eyebrow } = Astro.props;
const ro = language === "ro";
---

<section class="wrap not-found" aria-labelledby="not-found-title">
  <div class="not-found-art" aria-hidden="true">
    <span class="not-found-number">404</span>
    <WoodMotif />
  </div>
  <div class="not-found-copy">
    <p class="eyebrow">{eyebrow || (ro ? "404 / WhiteWOOD" : "404 / WhiteWOOD")}</p>
    <h1 id="not-found-title">{title}</h1>
    <p class="lede">{description}</p>
    <div class="not-found-actions">
      <a class="button" href={primaryHref}>{primaryLabel}<span aria-hidden="true">↗</span></a>
      <a class="button button--light" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>
