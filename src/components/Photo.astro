---
interface Props {
  name: string;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const { name, alt, class: className = "", sizes = "(max-width: 760px) 100vw, 60vw", loading = "lazy", fetchpriority = "auto" } = Astro.props;
const widths = [480, 960, 1000];
const avif = widths.map((width) => `/images/${name}-${width}.avif ${width}w`).join(", ");
const webp = widths.map((width) => `/images/${name}-${width}.webp ${width}w`).join(", ");
const fallback = `/images/${name}-1000.webp`;
---

<picture>
  <source type="image/avif" srcset={avif} sizes={sizes} />
  <source type="image/webp" srcset={webp} sizes={sizes} />
  <img class={className} src={fallback} srcset={webp} sizes={sizes} alt={alt} loading={loading} fetchpriority={fetchpriority} decoding="async" />
</picture>
